<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth thermal printer (classic SPP). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- One-time download of the handwriting-recognition model (Handwrite Quick Bill). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read this device's WiFi IP to show/connect for offline LAN sync between two counters. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Diary: voice notes, reminders/notifications -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Diary: attach current location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Save backups/exports to the public Downloads folder on older Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      WorkManager arrives transitively with ML Kit and declares a foreground service permission.
      The FOREGROUND_SERVICE permission is handled per build variant:
        - release (Play AAB): stripped in src/release/AndroidManifest.xml so Play needs no FGS declaration.
        - debug (WhatsApp APK): kept, plus FOREGROUND_SERVICE_MICROPHONE, in src/debug/AndroidManifest.xml
          for the diary's background voice-recording service.
      The WorkManager service itself is unused and stays removed for both variants (below).
    -->

    <!-- allowBackup is deliberately OFF. Android's OS-level Auto Backup (on when this was true,
         with no exclusion rules) silently backs up the whole pos_prefs SharedPreferences file —
         onboarded, customerMode, license state, everything — to the phone's Google account, and
         restores it automatically on the very next install under that account, before the app
         even runs. On a phone that was ever set up as a shop-owner install before, that meant
         every "fresh" reinstall silently came back with onboarded=true already set, skipping
         customer-link detection (see BootScreen) no matter how many times it was reinstalled —
         a phone that had never installed the app before had no such backup and worked fine. The
         app has its own explicit backup/restore (.zip export/import, see PendingImport/"backup"
         screen), so the OS's generic Auto Backup was both redundant and actively harmful here. -->
    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.POSBilling">

        <!-- singleTask, not singleTop: this is a single-Activity app (every screen is in-app
             Compose navigation, not a separate Activity), so singleTask's "reuse from anywhere,
             clear nothing above it" behavior is exactly what's wanted here, with no downside —
             singleTop only reused the existing instance when it was already the very top of its
             own task, so sharing a payment screenshot back in (from GPay/PhonePe etc.) after the
             task had gone to the background could launch a second copy instead of delivering to
             the one already showing the payment dialog via onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.POSBilling"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive a backup .zip shared from another app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <!-- Open a backup .zip from a file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Receive a photo / voice note / video / document shared from WhatsApp etc.,
                 to attach to a new diary entry. */* on purpose: WhatsApp documents come
                 through with all sorts of types (.docx, .xlsx, .txt …), and a narrow list
                 silently keeps the app out of the share sheet for them. A shared .zip is
                 still treated as a backup — that is decided by MIME type in code. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".diary.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".medical.ExpiryReceiver"
            android:exported="false" />

        <receiver
            android:name=".quicknote.QuickNoteReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".customer.CustomerNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".customer.ShopOrderPollReceiver"
            android:exported="false" />

        <service
            android:name=".push.PosMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".diary.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
