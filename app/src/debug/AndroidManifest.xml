<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug/APK-only overlay. Background voice recording needs a microphone foreground service,
  which the release (Play) AAB deliberately does not ship. These declarations apply only to
  the WhatsApp APK (assembleDebug); bundleRelease never sees them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <service
            android:name="com.billing.pos.audio.AudioRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
